<?xml version="1.0" encoding="utf-8"?>
<!-- The small icon of the app's notifications: the logo's goal frame with a ball in it. Android draws these in one
     colour from the shape alone, so it is white on transparent (the launcher icon would show as a white square). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Goal frame: two posts and the crossbar. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,20 V5 H21 V20" />
    <!-- Ball. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,10.5 a4,4 0 1,0 0.001,0 Z" />
</vector>
